# MT4 Terminal Configuration
# Copy this file to .env and update with your paths
# Format: terminal-id=path\to\terminal.exe

# Backtest terminals (sandboxed/portable)
mt4-01=C:\Users\adrian\dev\mt4-backtester\mt4\mt4-01\terminal.exe
mt4-02=C:\Users\adrian\dev\mt4-backtester\mt4\mt4-02\terminal.exe
# mt4-03=C:\Users\adrian\dev\mt4-backtester\mt4\mt4-03\terminal.exe

# Backtest output locations
mt4_bt_output=.\output
mt4_bt_ini=.\configs
mt4_bt_sets=.\sets

# EA spread parameter names (for auto-adjustment when test spread exceeds EA limits)
# If test spread > these params, script will warn and increase param by 100 in copied set file
mt4_spread_params=entry_max_spread_allowed_in_points,exit_max_spread_allowed_in_points